<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.OCR" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaryLightColor</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_start</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Background -->
        <item name="android:windowBackground">@drawable/bg_main_gradient</item>

        <!-- Card Styles -->
        <item name="cardViewStyle">@style/Widget.textX.Card</item>
    </style>

    <style name="Widget.textX.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="Widget.textX.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.textX.Button.Purple" parent="Widget.textX.Button">
        <item name="backgroundTint">@color/accent_purple</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.textX.Button.Teal" parent="Widget.textX.Button">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SearchViewTheme" parent="Widget.AppCompat.SearchView">
        <item name="android:textColorPrimary">#333333</item>
        <item name="android:textColorHint">#999999</item>
    </style>

    <style name="Theme.OCR.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.OCR.PopupOverlay" parent="ThemeOverlay.Material3.Light" />
</resources>