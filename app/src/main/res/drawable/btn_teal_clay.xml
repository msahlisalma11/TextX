<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/shadow_teal" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="45"
                        android:endColor="#4EB08D"
                        android:startColor="#5DCAA5"
                        android:type="linear" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="6dp" android:left="2dp" android:right="2dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>