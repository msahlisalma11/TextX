<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="45"
                        android:endColor="#6A61C2"
                        android:startColor="#7F77DD"
                        android:type="linear" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <!-- Suble inner top highlight for claymorphism -->
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke android:width="1dp" android:color="#30FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>